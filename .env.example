# MediKiosk configuration template. Do not place real secrets in this file.
# Exact provider/integration values remain pending approval.

# Runtime
MEDIKIOSK_ENV=development
MEDIKIOSK_LOG_LEVEL=INFO
MEDIKIOSK_FACILITY_ID=
MEDIKIOSK_PLUGIN_MANIFEST_PATH=

# Application/session
MEDIKIOSK_APP_SECRET=
MEDIKIOSK_ALLOWED_ORIGINS=
MEDIKIOSK_SESSION_TTL_SECONDS=

# Database and ephemeral state (Supabase Cloud + Docker local)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379/0
ARTIFACT_STORAGE_PROVIDER=supabase
ARTIFACT_STORAGE_BUCKET=medikiosk-records

# ModelService (Colab MedGemma primary + Gemini/Grok API fallback)
MODEL_PRIMARY_TEXT_PROVIDER=colab_medgemma
MODEL_PRIMARY_MULTIMODAL_PROVIDER=colab_medgemma
MODEL_FALLBACK_PROVIDER=gemini
COLAB_MEDGEMMA_URL=https://grape-alumni-hypnotize.ngrok-free.dev
GEMINI_API_KEY=
GROK_API_KEY=

# Document OCR & Imaging Pipeline
OCR_ENGINE=tesseract
OCR_FALLBACK_ENGINE=paddleocr

# Speech (Bhashini primary + Gemini fallback + local Web Speech fallback)
SPEECH_PRIMARY_PROVIDER=bhashini
SPEECH_FALLBACK_PROVIDER=gemini
BHASHINI_API_BASE_URL=https://dhruva-api.bhashini.gov.in
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=


# ABDM / HIS — use sandbox/mock values until approved credentials are available
ABDM_MODE=mock
ABDM_API_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=
ABDM_HIU_ID=
HIS_INTEGRATION_MODE=mock
HIS_API_BASE_URL=
HIS_CLIENT_ID=
HIS_CLIENT_SECRET=

# Security/observability
ENCRYPTION_KEY_REFERENCE=
AUDIT_LOG_RETENTION_DAYS=
HEALTH_CHECK_TOKEN=
