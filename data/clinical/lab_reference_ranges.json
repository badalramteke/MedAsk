          "borderline_high_max": 199.0,
          "high_threshold": 200.0,
          "critical_low_threshold": 50.0,
          "critical_high_threshold": 350.0
        }
      ],
      "flags": {
        "CRITICAL_LOW": "< 50.0 mg/dL",
