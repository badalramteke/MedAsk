{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "dataset_id": "lab_reference_ranges_v1",
  "description": "Structured reference range dataset for common clinical laboratory parameters. Designed to support baseline out-of-range detection while allowing laboratory-specific overrides.",
  "disclaimer": "These generic reference ranges serve as baseline defaults. Laboratory-specific reference intervals take precedence. Out-of-range lab flags are clinical indicators for physician review, not automated disease diagnoses.",
  "override_policy": "LABORATORY_PROVIDED_RANGE_OVERRIDE_ENABLED",
  "tests": [
    {
      "test_code": "LAB_FBG_001",
      "loinc_code": "1558-6",
      "name": "Fasting Blood Glucose",
      "aliases": [
        "FBG",
        "Fasting Blood Sugar",
        "FBS",
        "Fasting Plasma Glucose"
      ],
      "unit": "mg/dL",
      "specimen": "venous_plasma",
      "is_generic_default": true,
      "override_allowed": true,
      "reference_ranges": [
        {
          "population_context": "general_adult",
          "fasting_required": true,
          "normal_min": 70.0,
          "normal_max": 99.0,
          "borderline_high_min": 100.0,
          "borderline_high_max": 125.0,
          "high_threshold": 126.0,
          "critical_low_threshold": 50.0,
          "critical_high_threshold": 300.0
        }
      ],
      "flags": {
        "CRITICAL_LOW": "< 50.0 mg/dL",
        "LOW": "< 70.0 mg/dL",
        "NORMAL": "70.0 - 99.0 mg/dL",
        "HIGH": "> 99.0 mg/dL (Prediabetes: 100-125, Diabetes: >= 126)",
        "CRITICAL_HIGH": "> 300.0 mg/dL"
      }
    },
    {
      "test_code": "LAB_PPBG_002",
      "loinc_code": "1521-4",
