# MediKiosk configuration template. Do not place real secrets in this file.
# Exact provider/integration values remain pending approval.

# Runtime
MEDIKIOSK_ENV=development
MEDIKIOSK_LOG_LEVEL=INFO
MEDIKIOSK_FACILITY_ID=
MEDIKIOSK_PLUGIN_MANIFEST_PATH=

# Application/session
MEDIKIOSK_APP_SECRET=
MEDIKIOSK_ALLOWED_ORIGINS=
MEDIKIOSK_SESSION_TTL_SECONDS=

# Database and ephemeral state
DATABASE_URL=
REDIS_URL=
ARTIFACT_STORAGE_PROVIDER=
ARTIFACT_STORAGE_ENDPOINT=
ARTIFACT_STORAGE_BUCKET=
ARTIFACT_STORAGE_KEY=
ARTIFACT_STORAGE_SECRET=

# ModelService
MODEL_PRIMARY_TEXT_PROVIDER=
MODEL_PRIMARY_MULTIMODAL_PROVIDER=
MODEL_FALLBACK_PROVIDER=
OLLAMA_BASE_URL=
VLLM_BASE_URL=
GEMINI_API_KEY=
GROK_API_KEY=

# Speech
SPEECH_PRIMARY_PROVIDER=bhashini
SPEECH_FALLBACK_PROVIDER=ai4bharat
BHASHINI_API_BASE_URL=
BHASHINI_API_KEY=
AI4BHARAT_MODEL_PATH=

# ABDM / HIS — use sandbox/mock values until approved credentials are available
ABDM_MODE=mock
ABDM_API_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=
ABDM_HIU_ID=
HIS_INTEGRATION_MODE=mock
HIS_API_BASE_URL=
HIS_CLIENT_ID=
HIS_CLIENT_SECRET=

# Security/observability
ENCRYPTION_KEY_REFERENCE=
AUDIT_LOG_RETENTION_DAYS=
HEALTH_CHECK_TOKEN=
